# The running server needs NO secrets: callers send their own TfNSW API key in
# the X-API-Key header on every request. Do not set a key here expecting the
# server to use it — it will not.

# Bind address and port (defaults shown).
HOST=0.0.0.0
PORT=6401

# Used ONLY by the opt-in live tests, which are skipped when it is unset:
#   TFNSW_API_KEY=... uv run pytest -m live
# Get a free key from https://opendata.transport.nsw.gov.au
TFNSW_API_KEY=
